<Window x:Class="AceTRLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AceTR Launcher"
        Width="1636" Height="930"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#030A11"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <Image x:Name="SkinImage" Stretch="Fill" IsHitTestVisible="False"/>

        <!-- Drag surface: header except window controls -->
        <Border Height="174" VerticalAlignment="Top" Background="Transparent"
                MouseLeftButtonDown="Header_MouseLeftButtonDown"/>

        <!-- left asset buttons -->
        <Button Style="{StaticResource HitButton}" Width="322" Height="102" Margin="22,202,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Top" Click="Home_Click"/>
        <Button Style="{StaticResource HitButton}" Width="322" Height="102" Margin="22,312,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Top" Click="Discord_Click"/>
        <Button Style="{StaticResource HitButton}" Width="322" Height="102" Margin="22,422,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Top" Click="Facebook_Click"/>
        <Button Style="{StaticResource HitButton}" Width="322" Height="102" Margin="22,532,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Top" Click="Support_Click"/>

        <!-- center web view; hidden until web button is requested -->
        <Border x:Name="WebHostBorder" Visibility="Collapsed" Width="811" Height="522"
                Margin="379,273,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="#FF020A11" BorderBrush="#28CFFF" BorderThickness="1" CornerRadius="4"
                ClipToBounds="True">
            <Grid>
                <wv2:WebView2 x:Name="WebView"/>
                <Button Width="38" Height="38" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,8,8,0" Content="×" FontSize="20" Foreground="White"
                        Background="#CC041522" BorderBrush="#23CFFF" Cursor="Hand"
                        Click="CloseWeb_Click"/>
            </Grid>
        </Border>

        <!-- dynamic status values -->
        <Border Width="290" Height="64" Margin="1270,287,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="#E8041826" CornerRadius="5">
            <Grid>
                <TextBlock x:Name="ServerStateText" Text="ÇEVRİMİÇİ" Foreground="#45EB8D"
                           FontSize="20" FontWeight="Bold" Margin="24,8,0,0"/>
                <TextBlock x:Name="PingText" Text="Ping: -- ms" Foreground="#DDF7FF"
                           FontSize="14" Margin="24,38,0,0"/>
            </Grid>
        </Border>

        <!-- account controls -->
        <TextBox x:Name="AccountBox" Style="{StaticResource DarkInput}"
                 Width="270" Height="44" Margin="1313,537,0,0"
                 HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <PasswordBox x:Name="PasswordBox" Style="{StaticResource DarkPassword}"
                     Width="270" Height="44" Margin="1313,616,0,0"
                     HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <CheckBox x:Name="RememberCheck" Style="{StaticResource NeonCheck}" Content="Beni Hatırla"
                  Margin="1278,675,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <CheckBox x:Name="Bit64Check" Style="{StaticResource NeonCheck}" Content="64 BIT"
                  Margin="1488,675,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <CheckBox x:Name="WindowedCheck" Style="{StaticResource NeonCheck}" Content="Pencere Modu"
                  Margin="1278,710,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="True"/>

        <Button Style="{StaticResource HitButton}" Width="350" Height="78"
                Margin="1260,748,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                Click="Login_Click"/>

        <!-- Update bar -->
        <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Value="0"
                     Width="700" Height="18" Margin="450,877,0,0"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     Background="#041B2C" Foreground="#14D5FF" BorderBrush="#1F89B7"/>
        <TextBlock x:Name="UpdateText" Text="Dosyalar kontrol ediliyor..."
                   Foreground="#BCEBFA" FontSize="14" Margin="124,884,0,0"
                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBlock x:Name="ProgressText" Text="0%" Foreground="White" FontWeight="Bold"
                   FontSize="14" Margin="1090,882,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <!-- settings/min/close -->
        <Button Style="{StaticResource HitButton}" Width="210" Height="65"
                Margin="1408,850,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                Click="Settings_Click"/>
        <Button Style="{StaticResource HitButton}" Width="48" Height="48"
                Margin="1500,12,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                Click="Minimize_Click"/>
        <Button Style="{StaticResource HitButton}" Width="48" Height="48"
                Margin="1555,12,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                Click="Close_Click"/>

        <!-- transient state -->
        <Border x:Name="Toast" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,40" Background="#EF03131F" BorderBrush="#25CFFF" BorderThickness="1"
                CornerRadius="8" Padding="18,10">
            <TextBlock x:Name="ToastText" Foreground="#E9F8FF" FontSize="14"/>
        </Border>
    </Grid>
</Window>
