<Application x:Class="AceTRLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <DropShadowEffect x:Key="CyanGlow" Color="#18CFFF" BlurRadius="18" ShadowDepth="0" Opacity=".7"/>
        <Style x:Key="HitButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent" BorderThickness="2" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="#6DE7FF"/>
                                <Setter TargetName="B" Property="Effect" Value="{StaticResource CyanGlow}"/>
                                <Setter TargetName="B" Property="Background" Value="#1700B7F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#350082C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="#E8F8FF"/>
            <Setter Property="Background" Value="#F2041522"/>
            <Setter Property="BorderBrush" Value="#1A95C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#38D8FF"/>
        </Style>

        <Style x:Key="DarkPassword" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="#E8F8FF"/>
            <Setter Property="Background" Value="#F2041522"/>
            <Setter Property="BorderBrush" Value="#1A95C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#38D8FF"/>
        </Style>

        <Style x:Key="NeonCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D5F2FF"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="22" Height="22" CornerRadius="3"
                                    Background="#E9041B2B" BorderBrush="#1BCBFF" BorderThickness="1.5">
                                <Path x:Name="Tick" Visibility="Collapsed" Stroke="#FFFFFF" StrokeThickness="2.2"
                                      Data="M 4 11 L 9 16 L 18 6"/>
                            </Border>
                            <ContentPresenter Margin="8,1,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#C7008AD0"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Effect" Value="{StaticResource CyanGlow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
