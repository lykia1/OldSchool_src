<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x86</PlatformTarget>
    <AssemblyName>AceTRLauncher</AssemblyName>
    <RootNamespace>AceTRLauncher</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
  </ItemGroup>

  <ItemGroup>
    <None Update="launcher.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\launcher_master.jpg"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('Assets\launcher_master.jpg')" />
  </ItemGroup>
</Project>
