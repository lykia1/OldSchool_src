BEGIN
    DEFPUSHBUTTON   "WRM for LiveServer",IDOK,30,37,80,14
    CTEXT           "",IDC_STATIC_QUESTION,7,7,211,17
    PUSHBUTTON      "WRM for TestServer",IDC_BTN_FOR_TESTSERVER,116,37,80,14
END

IDD_DLG_XOR_TEST1 DIALOGEX 0, 0, 366, 110
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SC Encrytion"
FONT 9, "Microsoft Sans Serif", 0, 0, 0x0
BEGIN
    EDITTEXT        IDC_EDIT_SOURCE_STRING,57,7,302,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_KEY_STRING,57,23,302,15,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "Decrypt",IDC_BTN_XOR_ENCODE2,167,47,77,14
    EDITTEXT        IDC_EDIT_ENCOEDED_STRING,57,70,302,16,ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "OK",IDOK,309,89,50,14
    LTEXT           "Source String:",IDC_STATIC,15,10,42,8
    LTEXT           "Key String:",IDC_STATIC,25,26,32,8
    LTEXT           "Encoded String:",IDC_STATIC,9,72,48,8
END


