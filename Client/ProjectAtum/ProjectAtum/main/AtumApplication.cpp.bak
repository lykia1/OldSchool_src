///////////////////////////////////////////////////////////////////////////////
BOOL CAtumApplication::HS_UnInit()
{
	int	nRet = 0;
	
	// ¨ç _AhnHS_Uninitialize ÇÔĽö¸¦ ČŁĂâÇĎż© ÇŮ˝Żµĺ Ľ­şń˝ş¸¦ Áľ·áÇŐ´Ď´Ů.
	nRet = _AhnHS_Uninitialize();
	
	if ( nRet != HS_ERR_OK ) 
