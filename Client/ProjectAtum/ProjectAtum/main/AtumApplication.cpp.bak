/// \fn			VOID FieldSocketCharacterPayWarPoint(MSG_FC_CHARACTER_PAY_WARPOINT* pMsg)
/// \brief		żöĆ÷ŔÎĆ®°ˇ Áő°ˇÇĎż´Ŕ»°ćżě.
