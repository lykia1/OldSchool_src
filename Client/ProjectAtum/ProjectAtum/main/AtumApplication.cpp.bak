FLOAT CAtumApplication::GetFPS()
{
	if(COMPARE_RACE(m_pShuttleChild->m_myShuttleInfo.Race,RACE_OPERATION|RACE_GAMEMASTER))
	{
		return 30.f;
	}
	return m_fFPS; 
}
///////////////////////////////////////////////////////////////////////////////
/// \fn			
/// \brief		
/// \author		// 2008-06-16 by bhsohn EP3°ü·Ă ąö±×ĽöÁ¤
/// \date		2008-06-16 ~ 2008-06-16
/// \warning	
///
/// \param		
/// \return		
///////////////////////////////////////////////////////////////////////////////
void CAtumApplication::InitOptionEtcInfo(sOPTION_ETC* pEtc)
{
	pEtc->bRadioInfo[OPTION_RADIO_MAN_TO_MAN] = TRUE;			// 1:1ŔüĹő	
	pEtc->bRadioInfo[OPTION_RADIO_FORMATIONWAR] = TRUE;		// Ćí´ëŔüĹő
	pEtc->bRadioInfo[OPTION_RADIO_GUILD_WAR] = TRUE;			// ż©´ÜŔüĹő
	pEtc->bRadioInfo[OPTION_RADIO_WHISPER] = TRUE;			// ±ÓĽÓ¸»
	pEtc->bRadioInfo[OPTION_RADIO_FORMATION_INVITE] = TRUE;	// Ćí´ëĂĘ´ë
	pEtc->bRadioInfo[OPTION_RADIO_GUILD_INVITE] = TRUE;		// ż©´ÜĂĘ´ë
	pEtc->bRadioInfo[OPTION_RADIO_EXCHANGE] = TRUE;			// ±łČŻ
	pEtc->bRadioInfo[OPTION_RADIO_INTERFACE_POS] = FALSE;	// ŔÎĹÍĆäŔĚ˝ş Ŕ§Äˇ ŔúŔĺ
	pEtc->bRadioInfo[OPTION_RADIO_INTERFACE_HIDE] = FALSE;	// ŔÎĹÍĆäŔĚ˝ş ¸đµÎ °¨Ăß±â
	pEtc->bRadioInfo[OPTION_RADIO_FRIEND_ID_HIDE] = FALSE;	// °°Ŕş ĽĽ·Â ľĆŔĚµđ °¨Ăß±â
	pEtc->bRadioInfo[OPTION_RADIO_ENEMY_ID_HIDE] = FALSE;	// ´Ů¸Ą ĽĽ·Â ľĆŔĚµđ °¨Ăß±â
	pEtc->bRadioInfo[OPTION_RADIO_MOUSE_LOCK] = FALSE;	// ¸¶żě˝ş °ˇµÎ±â(Ŕ©µµżě ¸đµĺ˝Ă)
	pEtc->bRadioInfo[OPTION_RADIO_CHAT_FILTER] = TRUE;	// żĺÇĘĹÍ

	// ŔÎĹÍĆäŔĚ˝ş Ŕ§Äˇ 
	pEtc->stRateRect.fRateX = pEtc->stRateRect.fRateY = pEtc->stRateRect.fRateWidth = pEtc->stRateRect.fRateHeight = 0;

	// 2009. 02. 03 by ckPark Ă¤ĆĂĂ˘ ŔÎĹÍĆäŔĚ˝ş Ĺ©±â ŔúŔĺ
// 	pEtc->stRateRect.fGameWidth = g_pD3dApp->GetBackBufferDesc().Width;
// 	pEtc->stRateRect.fGameHeight = g_pD3dApp->GetBackBufferDesc().Height;

	memset(&(pEtc->stChatRect), 0, sizeof(stcuctRateRect));

	pEtc->stRateRect.fGameWidth = g_pD3dApp->GetWidth();
	pEtc->stRateRect.fGameHeight = g_pD3dApp->GetHeight();
	// end 2009. 02. 03 by ckPark Ă¤ĆĂĂ˘ ŔÎĹÍĆäŔĚ˝ş Ĺ©±â ŔúŔĺ
}

///////////////////////////////////////////////////////////////////////////////
