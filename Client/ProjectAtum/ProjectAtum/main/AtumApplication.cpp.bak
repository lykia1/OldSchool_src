	char * p = (char *)pMsg;
	p += sizeof(MSG_IC_CHAT_PARTY);
	memcpy(bufChat,p,size);
	char str[512];
	int temp,temp2;
	// 2006-04-13 by ispark
	CheckReadyStringFiltering(bufChat, &temp, &temp2);
