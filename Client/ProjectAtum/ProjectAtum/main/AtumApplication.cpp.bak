	{
		g_pStoreData->ChangeInfluenceMark(pMsg->Influence);
		// ¸đĽ±ŔĚ ¶°Á®ŔÖŔ¸¸é ¸¶Ĺ© ˝Ă˝şĹŰ ąŮ·Î Ŕűżë
		g_pStoreData->SetInfluenceMarkInfo(TRUE);
		g_pStoreData->UpdateInfluenceMark();	// ş»ŔÎ ±âĂĽ
		g_pStoreData->UpdateEnemyInfluenceMark();  // Ŕű±âĂĽ
