	// 2010. 07. 27 by hsLee ŔÎÇÇ´ĎĆĽ 2Â÷ °ĹÁˇ ąćľî ˝Ăł×¸¶ ż¬Ăâ ˝şĹµ Ăł¸®.
	else if ( pMsg->ErrorCode == ERR_INFINITY_MISMATCH_CREATEUID )
	{
		_asm nop
	}
		// 2010. 12. 01 by jskim ŔÎÇÇąć »ýĽş ¶Ç´Â ŔÔŔĺ˝Ă ¸Ţ˝ĂÁö Ăâ·Â 
	else if ( pMsg->ErrorCode == ERR_INFINITY_MISMATCH_LEVEL )
	{
		//_asm nop
		if( m_pInterface && m_pInterface->m_pInfinityPopup )
		{
			m_pInterface->m_pInfinityPopup->SetRoomJoinWait( FALSE );
			GetInfinityManager()->ClearMyRoomInfo();
		}
		m_pChat->CreateChatChild ( STRMSG_C_101201_0402 , COLOR_ERROR );	//"·ąş§ Á¦ÇŃŔ¸·Î ąć»ýĽş ą× ŔÔŔĺŔĚ şŇ°ˇ´ÉÇŐ´Ď´Ů.\\y"		 
	}
	// end 2010. 12. 01 by jskim ŔÎÇÇąć »ýĽş ¶Ç´Â ŔÔŔĺ˝Ă ¸Ţ˝ĂÁö Ăâ·Â 
	else if ( pMsg->ErrorCode == ERR_INFINITY_PLAYING_STATE )
	{
		_asm nop
	}
	else if ( pMsg->ErrorCode == ERR_INFINITY_ALWAYS_SKIP_ENDINGCINEMA )
	{
		_asm nop
	}
	// End 2010. 07. 27 by hsLee ŔÎÇÇ´ĎĆĽ 2Â÷ °ĹÁˇ ąćľî ˝Ăł×¸¶ ż¬Ăâ ˝şĹµ Ăł¸®.

	// 2010. 03. 29 by ckPark ŔÎÇÇ´ĎĆĽ ĆÄĆĽżřŔĚ ·ąµđ¸¦ ÇĎÁö ľĘŔş »óĹÂżˇĽ­ ˝ĂŔŰąöĆ°Ŕ» ´­·¶Ŕ» ¶§ ąö±× ĽöÁ¤
// 	else if( pMsg->ErrorCode == ERR_INFINITY_NOT_ALL_READY )
// 	{
// 		_asm nop
// 	}
	// end 2010. 03. 29 by ckPark ŔÎÇÇ´ĎĆĽ ĆÄĆĽżřŔĚ ·ąµđ¸¦ ÇĎÁö ľĘŔş »óĹÂżˇĽ­ ˝ĂŔŰąöĆ°Ŕ» ´­·¶Ŕ» ¶§ ąö±× ĽöÁ¤
	// end 2009. 11. 02 by ckPark ŔÎÇÇ´ĎĆĽ ÇĘµĺ ŔÎ˝şĹĎ˝ş ´řÁŻ ˝Ă˝şĹŰ



	// 2006-05-08 by ispark, DBGżˇĽ­¸¸ ŔŰµż
	else if(pMsg->ErrorCode == ERR_COMMON_BAD_NETWORK)
	{
		DBGOUT("\n<--------------------[BAD NETWORK!!!!!]-------------------->\n");
	}
	else
	{
		// ErrorCodeŔ¸·Î °Ë»öµÇÁö ľĘŔş żˇ·ŻŔÔ´Ď´Ů.
		return FALSE;
	}
	return TRUE;
}


