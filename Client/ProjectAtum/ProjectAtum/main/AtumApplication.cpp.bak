			wsprintf(buf,STRERR_C_RESOURCE_0003);//"Map ĆÄŔĎŔ» ·Îµů(ŔĎąÝ) ÇĎ´ÂµĄ ˝ÇĆĐ ÇĎż´˝Ŕ´Ď´Ů. ÇÁ·Î±×·ĄŔ» Áľ·áÇŐ´Ď´Ů!"
		}
		break;
