	// ¨ç _AhnHS_StopService ÇÔĽö¸¦ ČŁĂâÇĎż© ÇŮ˝Żµĺ Ľ­şń˝ş¸¦ Á¤ÁöÇŐ´Ď´Ů.
	nRet = _AhnHS_StopService();
	
	if ( nRet != HS_ERR_OK ) 
