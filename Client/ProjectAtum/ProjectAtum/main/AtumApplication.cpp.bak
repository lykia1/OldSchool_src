/// \fn			CAtumApplication::FieldSocketEventLeaveBuildingOk(MSG_FC_EVENT_LEAVE_BUILDING_OK* pMsg)
/// \brief		MSG_FC_EVENT_LEAVE_BUILDING_OK
/// \author		dhkwon
/// \date		2004-03-18 ~ 2004-03-18
/// \warning	
///
/// \param		
