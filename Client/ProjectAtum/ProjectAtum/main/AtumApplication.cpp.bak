///////////////////////////////////////////////////////////////////////////////
/// \fn			CAtumApplication::FieldSocketWarReqSignBoardStringListOk(MSG_FC_WAR_REQ_SIGN_BOARD_STRING_LIST_OK* pMsg)
/// \brief		ĽĽ·Â Ŕü±¤ĆÇ ŔüĂĽ ł»żë
/// \author		ispark
/// \date		2006-04-18 ~ 2006-04-18
