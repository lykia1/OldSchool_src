{
	MEX_QUEST_INFO* pCharacterQuest = g_pQuestData->FindCharacterQuest(pMsg->QuestIndex);
	if(pCharacterQuest)
	{	
		g_pQuestData->DeleteCharacterQuest(pMsg->QuestIndex);
	}
}

