		default:
			// ŔűŔýÇŃ Áľ·á ¸Ţ˝ĂÁö Ăâ·Â
			//lpszMsg = TEXT("°ÔŔÓ°ˇµĺ ˝ÇÇŕ Áß żˇ·Ż°ˇ ąß»ýÇĎż´˝Ŕ´Ď´Ů. °ÔŔÓ Ćú´ő ľČŔÇ GameGuardĆú´őżˇ ŔÖ´Â *.erl ĆÄŔĎµéŔ» Game1@inca.co.kr·Î Ă·şÎÇĎż© ¸ŢŔĎ ş¸ł»ÁÖ˝Ă±â ąŮ¶ř´Ď´Ů.ˇ±);
