{
	STUTORIAL_LIST_INFO *pTutorialInfo = (STUTORIAL_LIST_INFO *)((char *)pMsg + sizeof(MSG_FC_TUTORIAL_START_OK));
	int i = 0;
	for(i = 0 ; i < pMsg->TutorialInfoListCount ; i++)
	{
