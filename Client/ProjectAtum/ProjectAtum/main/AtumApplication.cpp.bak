			sprintf(szNotice, STRMSG_C_080521_0202);		//"¸đĽ±Ŕü ˝Â¸® ĽĽ·Â ŔĚşĄĆ® ÇŘÇÇľĆżö°ˇ Áľ·á µË´Ď´Ů."
			if(!bLevelUp)
			{
				m_pChat->CreateChatChild(szNotice ,COLOR_SYSTEM);
			}
			g_pGameMain->m_pUnitInfoBar->SetHappyHourMotherShip(bLevelUp, FALSE,pMsg);					
		}
		break;
	case GAME_EVENT_GROUP_MOTHERSHIP_START:
	case GAME_EVENT_GROUP_MOTHERSHIP_STARTING:
		{			
			if(pMsg->byStateType == GAME_EVENT_GROUP_MOTHERSHIP_START)
			{
				sprintf(szNotice, STRMSG_C_080521_0200);	//"¸đĽ±Ŕü ˝Â¸® ĽĽ·Â ŔĚşĄĆ® ÇŘÇÇľĆżö°ˇ ÁřÇŕ µË´Ď´Ů"
			}
			else
			{
				sprintf(szNotice, STRMSG_C_080521_0201);	//"¸đĽ±Ŕü ˝Â¸® ĽĽ·Â ŔĚşĄĆ® ÇŘÇÇľĆżö°ˇ ÁřÇŕ ÁßŔÔ´Ď´Ů."
			}			
			if(!bLevelUp)
			{
				m_pChat->CreateChatChild(szNotice ,COLOR_SYSTEM);			
			}
			g_pGameMain->m_pUnitInfoBar->SetHappyHourMotherShip(bLevelUp, TRUE, pMsg);
		}
		break;
		/////////////////// ľĆŔĚĹŰ ÇŘÇÇ ľĆżěľî /////////////////// 
	case GAME_EVENT_GROUP_ITEM_END:
		{
			sprintf(szNotice, STRMSG_C_080521_0205);		//"ĽşŔĺŔÇ ˝Ă°Ł ĽĽ·Â ŔĚşĄĆ® ÇŘÇÇľĆżö°ˇ Áľ·á µË´Ď´Ů."
			if(!bLevelUp)
			{
				m_pChat->CreateChatChild(szNotice ,COLOR_SYSTEM);
			}
			g_pGameMain->m_pUnitInfoBar->SetHappyHourItem(bLevelUp, FALSE,pMsg);		
		}
		break;
	case GAME_EVENT_GROUP_ITEM_START:
	case GAME_EVENT_GROUP_ITEM_STARTING:
		{
			if(pMsg->byStateType == GAME_EVENT_GROUP_ITEM_START)
			{
				sprintf(szNotice, STRMSG_C_080521_0203);	//"ĽşŔĺŔÇ ˝Ă°Ł ĽĽ·Â ŔĚşĄĆ® ÇŘÇÇľĆżö°ˇ ÁřÇŕ µË´Ď´Ů."
			}
			else
			{
				sprintf(szNotice, STRMSG_C_080521_0204);	//"ĽşŔĺŔÇ ˝Ă°Ł ĽĽ·Â ŔĚşĄĆ® ÇŘÇÇľĆżö°ˇ ÁřÇŕ ÁßŔÔ´Ď´Ů."
			}			
			if(!bLevelUp)
			{
				m_pChat->CreateChatChild(szNotice ,COLOR_SYSTEM);			
			}
			g_pGameMain->m_pUnitInfoBar->SetHappyHourItem(bLevelUp, TRUE, pMsg);
		}
		break;
	// end 2008-05-21 by bhsohn ¸đĽ±Ŕü, ľĆŔĚĹŰ ÇŘÇÇ ľĆżěľî Ăß°ˇ	
	}	
}

