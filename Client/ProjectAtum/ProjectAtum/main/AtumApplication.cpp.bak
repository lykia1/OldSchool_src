///////////////////////////////////////////////////////////////////////////////
/// \fn			
/// \brief		
/// \author		// 2008-06-20 by bhsohn EP3 żÉĽÇ°ü·Ă Ăł¸®
/// \date		2008-06-23 ~ 2008-06-23
/// \warning	
///
/// \param		
/// \return		
///////////////////////////////////////////////////////////////////////////////
void CAtumApplication::ShowPartyChangeInfo(SPARTY_INFO* pNewSetupInfo)
{
	if(NULL == m_pChat)
	{
		return;
	}
	SPARTY_INFO* pPartyInfo = g_pShuttleChild->m_pClientParty->GetSPartyInfo();
	char buf[512];
	memset(buf, 0x00, 512);
	{
		if(0 != strcmp(pNewSetupInfo->PartyPW, pPartyInfo->PartyPW))
		{
			wsprintf(buf, STRMSG_C_080714_0200); //"\\yĆí´ë şńąĐ ąřČŁ°ˇ şŻ°ćµÇľú˝Ŕ´Ď´Ů."
			m_pChat->CreateChatChild(buf,COLOR_SYSTEM);	
		}
		
		if((pNewSetupInfo->MinLevel != pPartyInfo->MinLevel)
			||(pNewSetupInfo->MaxLevel != pPartyInfo->MaxLevel))
		{
			wsprintf(buf, STRMSG_C_080714_0201); //"\\yĆí´ë Çăżë ·ąş§ŔĚ şŻ°ć µÇľú˝Ŕ´Ď´Ů."
			m_pChat->CreateChatChild(buf,COLOR_SYSTEM);	
		}
		if(pNewSetupInfo->ExpDistributeType != pPartyInfo->ExpDistributeType)		
		{
			switch(pNewSetupInfo->ExpDistributeType)
			{
			case EXP_DISTRIBUTE_TYPE_DAMAGE:		// ¸ó˝şĹÍżˇ ÁŘ µĄąĚÁöżˇ µű¸Ą °ćÇčÄˇ şĐąč
				{
					wsprintf(buf, STRMSG_C_080714_0202); // "\\y°ćÇčÄˇ şĐąč ąć˝ÄŔĚ °łŔÎ ˝Ŕµć ąć˝ÄŔ¸·Î şŻ°ćµÇľú˝Ŕ´Ď´Ů."
					m_pChat->CreateChatChild(buf,COLOR_SYSTEM);	
				}
				break;
			case EXP_DISTRIBUTE_TYPE_EQUALITY:		// ±Őµî şĐąč
				{
					wsprintf(buf, STRMSG_C_080714_0203); // "\\y°ćÇčÄˇ şĐąč ąć˝ÄŔĚ °řµż şĐąč ąć˝ÄŔ¸·Î şŻ°ćµÇľú˝Ŕ´Ď´Ů."
					m_pChat->CreateChatChild(buf,COLOR_SYSTEM);	
				}
				break;
			}			
		}
		if(pNewSetupInfo->ItemDistributeType != pPartyInfo->ItemDistributeType)		
		{
			switch(pNewSetupInfo->ItemDistributeType)
			{
			case ITEM_DISTRIBUTE_TYPE_DAMAGE:		// Ćí´ë ĽöÁ¤ - °łŔÎ ˝Ŕµć	
				{
					wsprintf(buf, STRMSG_C_080714_0204); // "\\yľĆŔĚĹŰ ˝Ŕµć ąć˝ÄŔĚ °łŔÎ ˝Ŕµć ąć˝ÄŔ¸·Î şŻ°ć µÇľú˝Ŕ´Ď´Ů."
					m_pChat->CreateChatChild(buf,COLOR_SYSTEM);	
				}
				break;
			case ITEM_DISTRIBUTE_TYPE_ORDER:		// EP3 Ćí´ë ĽöÁ¤ - ĽřÂ÷ ˝Ŕµć 
				{
					wsprintf(buf, STRMSG_C_080714_0205); // "\\yľĆŔĚĹŰ ˝Ŕµć ąć˝ÄŔĚ ĽřÂ÷ ˝Ŕµć ąć˝ÄŔ¸·Î şŻ°ć µÇľú˝Ŕ´Ď´Ů."
					m_pChat->CreateChatChild(buf,COLOR_SYSTEM);	
				}
				break;
			case ITEM_DISTRIBUTE_TYPE_RANDOM:		// EP3 Ćí´ë ĽöÁ¤ - ·Ł´ý ˝Ŕµć
				{
					wsprintf(buf, STRMSG_C_080714_0206); // "\\yľĆŔĚĹŰ ˝Ŕµć ąć˝ÄŔĚ ·Ł´ý ˝Ŕµć ąć˝ÄŔ¸·Î şŻ°ć µÇľú˝Ŕ´Ď´Ů."
					m_pChat->CreateChatChild(buf,COLOR_SYSTEM);	
				}
				break;
			}			
		}
	}
	wsprintf(buf, STRMSG_C_080609_0200); // "\\yżÉĽÇŔĚ şŻ°ćµÇľú˝Ŕ´Ď´Ů."
	m_pChat->CreateChatChild(buf,COLOR_SYSTEM);	
	
}

