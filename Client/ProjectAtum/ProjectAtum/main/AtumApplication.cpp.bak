/// \fn			CAtumApplication::FieldSocketQuestRequestSuccessCheckResult(MSG_FC_QUEST_REQUEST_SUCCESS_CHECK_RESULT* pMsg)
/// \brief		ĆÄĆĽąĚĽÇ Ľş°ř °á°úą°
