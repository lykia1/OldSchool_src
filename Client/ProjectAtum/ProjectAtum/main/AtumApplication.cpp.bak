{
	FLOG("CAtumApplication::FieldSocketBattleAttackHideItemWKind(MSG_FC_BATTLE_ATTACK_HIDE_ITEM_W_KIND* pMsg)");
	m_pScene->DeleteFieldItemOfFieldIndex( pMsg->TargetItemFieldIndex );
