{
	if((m_dwGameState == _GAME		||
		m_dwGameState == _CITY		||
		m_dwGameState == _MAPLOAD	||
		m_dwGameState == _SHOP		||
		m_dwGameState == _SELECTCHANNEL ) &&
		g_pShuttleChild)
	{
		g_pShuttleChild->m_pClientParty->IPartyAcceptInviteOk(pMsg);
	}
}

