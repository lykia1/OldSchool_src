///////////////////////////////////////////////////////////////////////////////
/// \fn			
/// \brief		
/// \author		// 2008-03-17 by bhsohn Ŕ©µµżě ŔĚµż˝Ă TickľČµéľîżŔ´Â ą®Á¦ Ăł¸®
/// \date		2008-03-17 ~ 2007-11-22
/// \warning	
///
/// \param		
/// \return		
///////////////////////////////////////////////////////////////////////////////
BOOL CAtumApplication::IsPossibleWindowMove()
{
	DWORD dwGameState = GetGameState();
	switch(dwGameState)
	{
	case _GAME:
		{
			if(m_bCharacter 
				|| (NULL == m_pShuttleChild)
				||(!m_pShuttleChild->IsAir()))
			{
				// ¶Ążˇ ŔÖ°ĹłŞ Äł¸ŻĹÍ ¸đµĺ¸é żňÁ÷ŔĎĽö ŔÖ´Ů.
				return TRUE;
			}		
			return m_pShuttleChild->IsUnitStop();			
		}
		break;		
	}				
	return TRUE;	
}

///////////////////////////////////////////////////////////////////////////////
/// \fn			
/// \brief		
/// \author		// 2008-03-27 by bhsohn ąĚĽÇĽş°řĂ˘ŔĚ ¶°ŔÖ´Â »óĹÂżˇĽ­´Â »óÁˇŔĚ ľČż­¸®°Ô şŻ°ć
/// \date		2008-03-27 ~ 2008-03-27
/// \warning	
///
/// \param		
/// \return		
///////////////////////////////////////////////////////////////////////////////
BOOL CAtumApplication::IsPossibleShopOpen()
{	
	if(g_pGImage->GetRenderFlag() && (MISSION_SUC == g_pGImage->GetSelectImageIndex()))		
	{
		return FALSE;
	}
	// 2008-06-24 by bhsohn ąŮŔÚ»óÁˇ°ú Äł˝¬»óÁˇ µż˝Ăżˇ ¶ßżě±â şŇ°ˇ´ÉÇĎ°Ô ÇÔ
	else if(g_pInterface->IsBazarOpen())
	{		
		return FALSE;		
	}	
	// end 2008-06-24 by bhsohn ąŮŔÚ»óÁˇ°ú Äł˝¬»óÁˇ µż˝Ăżˇ ¶ßżě±â şŇ°ˇ´ÉÇĎ°Ô ÇÔ
	return TRUE;

}

///////////////////////////////////////////////////////////////////////////////
/// \fn			
/// \brief		¸đĽ±Ŕü Á¤ş¸ żäĂ»żˇ ´ëÇŃ ŔŔ´ä
/// \author		// 2008-03-19 by bhsohn ¸đĽ±Ŕü, °ĹÁˇŔü Á¤ş¸Ă˘
/// \date		2008-03-19 ~ 2008-03-19
/// \warning	
///
/// \param		
/// \return		
///////////////////////////////////////////////////////////////////////////////
void CAtumApplication::FieldSocketInfoMsWarInfoResultOk(MSG_FC_INFO_MSWARINFO_RESULT_OK* pMsg)
{
	GUI_BUILDINGNPC* pBuilding = g_pInterface->m_pCityBase->GetCurrentBuildingNPC();
	if(NULL == pBuilding)
	{
		return;
	}
	int nBuildingKind = pBuilding->buildingInfo.BuildingKind;
	// 2008-10-16 by bhsohn ŔüÁř±âÁö ¸đĽ±Ŕü, °ĹÁˇŔü Á¤ş¸Ă˘
//	if(BUILDINGKIND_CITYLEADER_LEADER != nBuildingKind)
//	{
//		return;
//	}
	if((BUILDINGKIND_CITYLEADER_LEADER != nBuildingKind)
		&&(BUILDINGKIND_CITYLEADER_OUTPOST != nBuildingKind))	// 2008-10-16 by bhsohn ŔüÁř±âÁö ¸đĽ±Ŕü, °ĹÁˇŔü Á¤ş¸Ă˘
	{
		return;
	}

	CMapCityShopIterator it = g_pInterface->m_pCityBase->m_mapCityShop.find(nBuildingKind);
	if(it == g_pInterface->m_pCityBase->m_mapCityShop.end() || NULL == it->second)
	{
		return;
	}
	//CINFCityLeader * pCityLeader = ((CINFCityLeader*)it->second);

	char szMonsterName[SIZE_MAX_MONSTER_NAME];	// ¸ó˝şĹÍ ŔĚ¸§
	memset(szMonsterName, 0x00, SIZE_MAX_MONSTER_NAME);

	// ĂĘ±âČ­ 
	//pCityLeader->InitWarInfoMothership();
	if(BUILDINGKIND_CITYLEADER_LEADER == nBuildingKind)
	{
		CINFCityLeader * pCityLeader = ((CINFCityLeader*)it->second);
		pCityLeader->InitWarInfoMothership();

	}
	else if(BUILDINGKIND_CITYLEADER_OUTPOST == nBuildingKind)
	{
		CINFCityOutPost * pOutPost = ((CINFCityOutPost*)it->second);
		pOutPost->InitWarInfoMothership();
	}


	// ľĆŔĚĹŰ µî·Ď
	SMSWAR_INFO_RESULT * pMsgItem = (SMSWAR_INFO_RESULT *)((char *)pMsg + sizeof(MSG_FC_INFO_MSWARINFO_RESULT_OK));
	for(int i = 0; i < pMsg->MSWarInfoResultListCount; i++)
	{
		MEX_MONSTER_INFO* pMonsterInfo = g_pDatabase->CheckMonsterInfo(pMsgItem->MonsterUID);
		if(pMonsterInfo)
		{
			STRNCPY_MEMSET(szMonsterName,pMonsterInfo->MonsterName,SIZE_MAX_MONSTER_NAME);
		}
		else
		{
			memset(szMonsterName, 0x00, SIZE_MAX_MONSTER_NAME);
		}
		// 2008-10-16 by bhsohn ŔüÁř±âÁö ¸đĽ±Ŕü, °ĹÁˇŔü Á¤ş¸Ă˘
//		pCityLeader->AddWarInfoMothership(pMsgItem->AttInfluence,	// °ř°ÝĽĽ·Â
//								pMsgItem->WinInfluence,		// ˝Â¸®ĽĽ·Â
//								szMonsterName,				// ¸đĽ±ŔĚ¸§
//								pMsgItem->ContributionPoint,				// ĽĽ·ÂĆ÷ŔÎĆ®
//								pMsgItem->MSWarStartTime,	// ˝ĂŔŰ˝Ă°Ł
//								pMsgItem->MSWarEndTime);	//Áľ·á˝Ă°Ł	

		
		if(BUILDINGKIND_CITYLEADER_LEADER == nBuildingKind)
		{
			CINFCityLeader * pCityLeader = ((CINFCityLeader*)it->second);
			pCityLeader->AddWarInfoMothership(pMsgItem->AttInfluence,	// °ř°ÝĽĽ·Â
								pMsgItem->WinInfluence,		// ˝Â¸®ĽĽ·Â
								szMonsterName,				// ¸đĽ±ŔĚ¸§
								pMsgItem->ContributionPoint,				// ĽĽ·ÂĆ÷ŔÎĆ®
								pMsgItem->MSWarStartTime,	// ˝ĂŔŰ˝Ă°Ł
								pMsgItem->MSWarEndTime);	//Áľ·á˝Ă°Ł	
		}
		else if(BUILDINGKIND_CITYLEADER_OUTPOST == nBuildingKind)
		{
			CINFCityOutPost * pOutPost = ((CINFCityOutPost*)it->second);
			pOutPost->AddWarInfoMothership(pMsgItem->AttInfluence,	// °ř°ÝĽĽ·Â
								pMsgItem->WinInfluence,		// ˝Â¸®ĽĽ·Â
								szMonsterName,				// ¸đĽ±ŔĚ¸§
								pMsgItem->ContributionPoint,				// ĽĽ·ÂĆ÷ŔÎĆ®
								pMsgItem->MSWarStartTime,	// ˝ĂŔŰ˝Ă°Ł
								pMsgItem->MSWarEndTime);	//Áľ·á˝Ă°Ł	
			
		}
		// end 2008-10-16 by bhsohn ŔüÁř±âÁö ¸đĽ±Ŕü, °ĹÁˇŔü Á¤ş¸Ă˘

		pMsgItem++;
	}
	// 2008-04-22 by bhsohn ¸đĽ±/°ĹÁˇŔü ÁřÇŕÁßŔÎ Á¤ş¸µµ ÇĄ˝Ă ÇĎ°Ô şŻ°ć
	// ÇöŔç ÁřÇŕÁßŔÎ °ĹÁˇŔü 
	g_pGameMain->UpdatePlayingMotherShipInfo();
	
	// end 2008-04-22 by bhsohn ¸đĽ±/°ĹÁˇŔü ÁřÇŕÁßŔÎ Á¤ş¸µµ ÇĄ˝Ă ÇĎ°Ô şŻ°ć
}

///////////////////////////////////////////////////////////////////////////////
/// \fn			
/// \brief		°ĹÁˇŔü Á¤ş¸ żäĂ»żˇ ´ëÇŃ ŔŔ´ä
/// \author		// 2008-03-19 by bhsohn ¸đĽ±Ŕü, °ĹÁˇŔü Á¤ş¸Ă˘
