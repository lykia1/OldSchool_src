	CMapMonsterIterator itMonster = m_pScene->m_mapMonsterList.find(pMsg->MonsterIndex);
	if(itMonster != m_pScene->m_mapMonsterList.end())
	{ 
	
     	itMonster->second->ChangeMonster(pMsg->ChangeMonsterUnitKind);	
	}	
}	
