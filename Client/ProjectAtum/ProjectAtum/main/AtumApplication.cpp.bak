	// 2008-03-03 by bhsohn ĹëÇŐ ľĆ·ąłŞ IMĽ­ąö ż¬°á°úÁ¤ ĽöÁ¤
	//g_pGameMain->m_pInfWindow->AddTimeMsgBox(STRMSG_C_070504_0100, _Q_ARENA_WARP,30,STRMSG_C_060724_0000);	
	// ż¬°áµÇľîŔÖŔ¸¸é ¸Ţ˝ĂÁö Ă˘Ŕ» ¶ěżî´Ů.
	DoModalAreanQuestion();	
}
