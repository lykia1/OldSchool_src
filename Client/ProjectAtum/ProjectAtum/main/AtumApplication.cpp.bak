///////////////////////////////////////////////////////////////////////////////
BOOL CAtumApplication::IsOptionEtc(int nOptionIdx)
{
	if(!g_pSOptionEtc || nOptionIdx < 0 || nOptionIdx >= MAX_OPTION_RADIO)
	{
		return FALSE;
	}
	return g_pSOptionEtc->bRadioInfo[nOptionIdx];
}

