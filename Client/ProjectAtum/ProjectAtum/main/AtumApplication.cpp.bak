}

///////////////////////////////////////////////////////////////////////////////
/// \fn			BOOL	HS_StartService()
/// \brief		ÇŮ˝Żµĺ Ľ­şń˝ş ˝ĂŔŰ ÇÔĽö
/// \author		ispark
/// \date		2006-06-02 ~ 2006-06-02
/// \warning	
///
/// \param		
/// \return		
///////////////////////////////////////////////////////////////////////////////
BOOL CAtumApplication::HS_StartService()
{
	int		nRet = 0;
//	TCHAR	szMsg[MAX_PATH];
	
	// ¨ç _AhnHS_StartService ÇÔĽö¸¦ ČŁĂâÇĎż© ÇŮ˝Żµĺ Ľ­şń˝ş¸¦ ˝ĂŔŰÇŐ´Ď´Ů.
	nRet = _AhnHS_StartService();
	
	// ¨č _AhnHS_StartService ÇÔĽöŔÇ ¸®ĹĎ °ŞŔ» °Ë»çÇĎż© żˇ·Ż Ăł¸®ÇŐ´Ď´Ů.
	if ( nRet != HS_ERR_OK )
	{
		switch ( nRet )
		{
		case HS_ERR_START_ENGINE_FAILED:
		case HS_ERR_DRV_FILE_CREATE_FAILED:
		case HS_ERR_REG_DRV_FILE_FAILED:
		case HS_ERR_START_DRV_FAILED:
		default:
			{
				DBGOUT("HS_StartService Error(%x)\n", nRet);
			}
//			wsprintf ( szMsg, "ÇŘĹ· ąćÁö ±â´Éżˇ ą®Á¦°ˇ ąß»ý ÇĎż´˝Ŕ´Ď´Ů(%x)", nRet );
			break;
		}
//		MessageBox( NULL, szMsg, "żˇ·Ż", MB_OK );
		return FALSE;
	}
	DBGOUT("---------- AhnHS Service Start ----------\n");
	return TRUE;
}

