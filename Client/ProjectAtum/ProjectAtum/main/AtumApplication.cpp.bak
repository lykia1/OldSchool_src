///////////////////////////////////////////////////////////////////////////////
/// \fn			CAtumApplication::FieldSocketSKillPrepareUseOk(MSG_FC_SKILL_PREPARE_USE_OK* pMsg)
/// \brief		ąßµżµČ ˝şĹł ŔĚĆĺĆ®¸¦ Ăß°ˇÇŃ´Ů.
/// \author		jschoi
