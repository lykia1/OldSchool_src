void CAtumApplication::SetOptionInterfacePOS(stcuctRateRect* pRect)
{
	if(!g_pSOptionEtc)
	{
		return;
	}
	memcpy(&g_pSOptionEtc->stRateRect, pRect, sizeof(stcuctRateRect));

}

