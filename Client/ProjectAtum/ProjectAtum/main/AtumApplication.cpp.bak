// 2010. 01. 12 by ckPark ą«°Ô °ÔŔĚÁö °č»ę˝Ă ľĆŔĚĹŰ ˝şĹÝŔĚ ľĆ´Ń żřş» ˝şĹÝŔ¸·Î °č»ęÇĎ´ř ą®Á¦ ÇŘ°á
void	CAtumApplication::FieldSocketPutAllQuestDone( void )
{
	float fWeight = g_pStoreData->GetTotalWeight() / CAtumSJ::GetTransport(&g_pShuttleChild->m_myShuttleInfo);
	if(fWeight >= 0.9f)
	{
		m_pChat->CreateChatChild(STRMSG_C_INTERFACE_0044,COLOR_SYSTEM);//"±âľî ŔűŔç·®ŔÇ 90%¸¦ ĂĘ°ú ÇĎż´˝Ŕ´Ď´Ů."
		m_pChat->CreateChatChild(STRMSG_C_INTERFACE_0045,COLOR_SYSTEM);//"ĂÖĽŇ ĽÓµµ·Î¸¸ ŔĚµż°ˇ´ÉÇĎ¸ç, ż¬·áĽŇ¸đ·®ŔĚ Áő°ˇÇŐ´Ď´Ů."
	}
	else if(fWeight > WEIGHT_RATE_VERY_HEAVY)
	{
		m_pChat->CreateChatChild(STRMSG_C_INTERFACE_0046,COLOR_SYSTEM);//"±âľî ŔűŔç·®ŔÇ 80%¸¦ ĂĘ°ú ÇĎż´˝Ŕ´Ď´Ů."
		m_pChat->CreateChatChild(STRMSG_C_INTERFACE_0047,COLOR_SYSTEM);//"şÎ˝şĹÍŔÇ »çżëŔĚ Á¦ÇŃµÇ¸ç, ż¬·áĽŇ¸đ·®ŔĚ Áő°ˇÇŐ´Ď´Ů."
	}
	else if(fWeight >= WEIGHT_RATE_HEAVY)
	{
		m_pChat->CreateChatChild(STRMSG_C_INTERFACE_0048,COLOR_SYSTEM);//"±âľî ŔűŔç·®ŔÇ 70%¸¦ ĂĘ°úÇĎż© ż¬·áĽŇ¸đ·®ŔĚ Áő°ˇÇŐ´Ď´Ů."
	}
}
