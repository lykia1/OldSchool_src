			g_bEventRecovery = FALSE;
			g_fEventRecoveryRate = 0.0f;		
		}
		
	}
	// end 2009-03-31 by bhsohn ŔĚşĄĆ® Č¸şą·ü ąö±× ĽöÁ¤
}

