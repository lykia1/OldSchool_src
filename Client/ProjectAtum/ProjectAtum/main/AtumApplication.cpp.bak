///////////////////////////////////////////////////////////////////////////////
/// \fn			
/// \brief		
/// \author		// 2011-05-31 by jhahn	ŔÎÇÇ3Â÷˝Ăł×¸¶ şŻ°ć
/// \date		2011-05-31
/// \warning	
///
/// \param		
/// \return		
///////////////////////////////////////////////////////////////////////////////
void	CAtumApplication::FieldInfinityCinemaOK(MSG_FC_INFINITY_MOVIE* pMsg)
{
	if(pMsg->Command == 1)
	{
		// 2011-07-12 by jhahn  ŔÎÇÇ3Â÷ ˝Ăł×¸¶ Ĺ¸Äł¸ŻĹÍ ľČş¸ŔĚ±â
		CAppEffectData* pEffect = g_pScene->FindEffect( RC_EFF_BOOSTER );
		if(pEffect)
		{
			pEffect->ChangeBodyCondition(BODYCON_LANDED_MASK);
			}
			
		g_pShuttleChild->Infinity3Cinema(pMsg->UniqueNumber);		

		CMapEnemyIterator itEnemy = m_pScene->m_mapEnemyList.begin();	
		while(itEnemy != m_pScene->m_mapEnemyList.end())
		{ 
		
			itEnemy->second->m_bRender = FALSE;		
			itEnemy->second->SetHideData();
			
			
			itEnemy++;
		}		
		//end 2011-07-12 by jhahn  ŔÎÇÇ3Â÷ ˝Ăł×¸¶ Ĺ¸Äł¸ŻĹÍ ľČş¸ŔĚ±â
	}

}
///////////////////////////////////////////////////////////////////////////////
/// \fn			
/// \brief		°ÔŔÓ°ˇµĺ ˝ĂŔŰ
/// \author		// 2008-11-28 by bhsohn XignCodeĂß°ˇ
/// \date		2008-11-28 ~ 2008-11-28
/// \warning	
///
/// \param		
/// \return		
///////////////////////////////////////////////////////////////////////////////
BOOL CAtumApplication::StartGameGuard()
{
	int nGameGuard = GAMEGUARD_TYPE;
	switch(nGameGuard)
	{
	case USE_GAMEGUARD_AHNLAB_HACKSHIELD:
		{
			//ÇŮ˝Żµĺ °ÔŔÓ°ˇµĺ
			if(!HS_Start())
			{			
				return FALSE;
			}

		}
		break;
	case USE_GAMEGUARD_XIGNCODE:	
		{
			// 2009-01-22 by bhsohn Xign Code »çżëÇĎ´Â łŞ¶ó¸¸ ¸đµâ Ăß°ˇ
		#if defined(DEFINE_USE_GAMEGUARD_XIGNCODE)	
			// 2009-01-20 by bhsohn XignÄÚµĺ Ăß°ˇ żäĂ»
			// 2009-05-12 by bhsohn XignCode ˝Ç˝Ă°Ł Áľ·á ±â´É Ăß°ˇ
// 			if (ZCWAVE_SysEnter(NULL, ZSOPT_SHOWSPLASH|ZSOPT_SHOWTRAY) != TRUE)
// 			{
// 				return FALSE;
// 			}
			if (ZCWAVE_SysEnter("Xigncode", ZSOPT_USESYSGUARD | ZSOPT_SHOWSPLASH | ZSOPT_SHOWTRAY) != TRUE)
			{
				return FALSE;
			}
			// end 2009-05-12 by bhsohn XignCode ˝Ç˝Ă°Ł Áľ·á ±â´É Ăß°ˇ
			// end 2009-01-20 by bhsohn XignÄÚµĺ Ăß°ˇ żäĂ»

			//Xign °ÔŔÓ°ˇµĺ
			if(!ZCWAVE_Init())
			{
				DBGOUT("CAtumApplication::StartGameGuard [FALSE] \n");
				return FALSE;
			}
			DBGOUT("CAtumApplication::StartGameGuard [TRUE] \n");
			
			// 2009-01-22 by bhsohn Xign Code˝Ă, Sleep(3000)Ăß°ˇ
			Sleep(3000);
			// end 2009-01-22 by bhsohn Xign Code˝Ă, Sleep(3000)Ăß°ˇ
		#endif
			// end 2009-01-22 by bhsohn Xign Code »çżëÇĎ´Â łŞ¶ó¸¸ ¸đµâ Ăß°ˇ
		}
		break;
		// 2009-01-28 by bhsohn nProtector °ÔŔÓ °ˇµĺ Ăß°ˇ	
	case USE_GAMEGUARD_NPROTECTOR:
		{
		#if defined(DEFINE_USE_GAMEGUARD_NPROTECTOR)
			if(!InitGameGuardNProtector())
			{
				return FALSE;
			}			
		#endif
		}
		break;
	// end 2009-01-28 by bhsohn nProtector °ÔŔÓ °ˇµĺ Ăß°ˇ


		// 2009. 06. 17 by ckPark Frost System
	case USE_GAMEGUARD_FROST:
		{
			#if defined( DEFINE_USE_GAMEGUARD_FROST )
			 frostInitialize( ".\\Frost\\gameShieldDll.dll" );
			 frostSetUserName( m_strUserID );
			#endif
		}
		break;
		// end 2009. 06. 17 by ckPark Frost System
	// 2009. 09. 21 by jskim °ÔŔÓ°ˇµĺ XTRAP Ŕűżë(ąčĆ®ł˛) 
	case USE_GAMEGUARD_XTRAP:
		{
			#if defined( DEFINE_USE_GAMEGUARD_XTRAP )

				char szXtrapArg[] = XTRAP_LICENCE_CODE;
				XTrap_C_Start((LPCSTR)szXtrapArg, NULL);
			#endif
		}
		break;
	//end 2009. 09. 21 by jskim °ÔŔÓ°ˇµĺ XTRAP Ŕűżë(ąčĆ®ł˛) 

	// 2009. 11. 03 by ckPark ĹÂ±ą APEX °ÔŔÓ°ˇµĺ ŔŰľ÷
	case USE_GAMEGUARD_APEX:
		{
			#if defined( DEFINE_USE_GAMEGUARD_APEX )

			#endif
		}
		break;
	// end 2009. 11. 03 by ckPark ĹÂ±ą APEX °ÔŔÓ°ˇµĺ ŔŰľ÷

	case USE_GAMEGUARD_NONE:
		{

		}
		break;
	}
	return TRUE;

}

///////////////////////////////////////////////////////////////////////////////
/// \fn			
/// \brief		°ÔŔÓ°ˇµĺ Áľ·á
/// \author		// 2008-11-28 by bhsohn XignCodeĂß°ˇ
/// \date		2008-11-28 ~ 2008-11-28
/// \warning	
///
/// \param		
/// \return		
///////////////////////////////////////////////////////////////////////////////
BOOL CAtumApplication::CloseGameGuard()
{
	int nGameGuard = GAMEGUARD_TYPE;
	switch(nGameGuard)
	{
	case USE_GAMEGUARD_AHNLAB_HACKSHIELD:
		{
			//ÇŮ˝Żµĺ °ÔŔÓ°ˇµĺ
			HS_Close();	
		}
		break;
	case USE_GAMEGUARD_XIGNCODE:	
		{		
			// 2009-01-22 by bhsohn Xign Code »çżëÇĎ´Â łŞ¶ó¸¸ ¸đµâ Ăß°ˇ
		#if defined(DEFINE_USE_GAMEGUARD_XIGNCODE)		
			// 2009-01-20 by bhsohn XignÄÚµĺ Ăß°ˇ żäĂ»
			//Xign °ÔŔÓ°ˇµĺ
// 			if(!ZCWAVE_Cleanup())
// 			{
// 				DBGOUT("CAtumApplication::CloseGameGuard [FALSE] \n");
// 				return FALSE;			
// 			}						
			ZCWAVE_Cleanup();
			ZCWAVE_SysExit();
			// end 2009-01-20 by bhsohn XignÄÚµĺ Ăß°ˇ żäĂ»

			DBGOUT("CAtumApplication::CloseGameGuard [TRUE] \n");
		#endif
			// 2009-01-22 by bhsohn Xign Code »çżëÇĎ´Â łŞ¶ó¸¸ ¸đµâ Ăß°ˇ
		}
		break;
		// 2009-01-28 by bhsohn nProtector °ÔŔÓ °ˇµĺ Ăß°ˇ	
	case USE_GAMEGUARD_NPROTECTOR:
		{
#if defined(DEFINE_USE_GAMEGUARD_NPROTECTOR)
			SAFE_DELETE(m_pNpgl);
#endif
		}
		break;
	// end 2009-01-28 by bhsohn nProtector °ÔŔÓ °ˇµĺ Ăß°ˇ
	// 2009. 09. 21 by jskim °ÔŔÓ°ˇµĺ XTRAP Ŕűżë(ąčĆ®ł˛)
	case USE_GAMEGUARD_XTRAP:
		{
			#if defined( DEFINE_USE_GAMEGUARD_XTRAP )
			#endif
		}
		break;
	//end 2009. 09. 21 by jskim °ÔŔÓ°ˇµĺ XTRAP Ŕűżë(ąčĆ®ł˛)
	
	// 2009. 11. 03 by ckPark ĹÂ±ą APEX °ÔŔÓ°ˇµĺ ŔŰľ÷
	case USE_GAMEGUARD_APEX:
		{
			#if defined( DEFINE_USE_GAMEGUARD_APEX )
			CHCEnd();
			#endif
		}
		break;
	// end 2009. 11. 03 by ckPark ĹÂ±ą APEX °ÔŔÓ°ˇµĺ ŔŰľ÷


	// 2010. 01. 13 by ckPark Frost°ÔŔÓ°ˇµĺ 2009.11.10ŔĎŔÚ ľ÷µĄŔĚĆ®
	case USE_GAMEGUARD_FROST:
		{
			#if defined( DEFINE_USE_GAMEGUARD_FROST )
			frostFinalize();
			#endif
		}
		break;
	// end 2010. 01. 13 by ckPark Frost°ÔŔÓ°ˇµĺ 2009.11.10ŔĎŔÚ ľ÷µĄŔĚĆ®

	case USE_GAMEGUARD_NONE:
		{

		}
		break;
	}
	return TRUE;

}

///////////////////////////////////////////////////////////////////////////////
/// \fn			
/// \brief		ĂłŔ˝ ĂĘ±âČ­ ÇÔĽö
/// \author		// 2008-11-28 by bhsohn XignCodeĂß°ˇ
/// \date		2008-11-28 ~ 2008-11-28
/// \warning	
///
/// \param		
/// \return		
///////////////////////////////////////////////////////////////////////////////
VOID CAtumApplication::FieldSocketMoveXignCodeReqScanInit(UINT nSocketNotifyType, MSG_FC_MOVE_XIGNCODE_REQ_SCAN_INIT* pMsg)
{
	if(WM_PACKET_ARENA_NOTIFY == nSocketNotifyType)		
	{
		// ľĆ·ąłŞ ĽŇÄĎŔĚ¸é ą«˝Ă
		return;
	}
	// 2009-01-22 by bhsohn Xign Code »çżëÇĎ´Â łŞ¶ó¸¸ ¸đµâ Ăß°ˇ
#if defined(DEFINE_USE_GAMEGUARD_XIGNCODE)		
	MSG_FC_MOVE_XIGNCODE_REQ_SCAN_INIT_OK sRtnMsg;
	memset(&sRtnMsg, 0x00, sizeof(MSG_FC_MOVE_XIGNCODE_REQ_SCAN_INIT_OK));
	
	BOOL bProbe = ZCWAVE_Probe((CPACKETDATA)pMsg->byCheckData, (PACKETDATA)sRtnMsg.byResultData, MAX_PACKET_SIZE_FOR_XIGNCODE);
	// Ľ­ąö·Î şÎĹÍ ŔüĽŰąŢŔş µĄŔĚĹÍ¸¦ ŔÔ·ÂÇŐ´Ď´Ů. 
	if(bProbe) 
	{ 
		// szReturnżˇ ŔúŔĺµČ ˝ÇÇŕ °á°ú µĄŔĚĹÍ¸¦ 
		// Ľ­ąö·Î ŔüĽŰÇŐ´Ď´Ů. 		
		m_pFieldWinSocket->SendMsg(T_FC_MOVE_XIGNCODE_REQ_SCAN_INIT_OK, (char*)&sRtnMsg, sizeof(sRtnMsg)); 	
		
		// ´Ů˝Ă ż¬°á
		// Ľ­ąö·ÎşÎĹÍ Ŕü´ŢąŢŔş ŔĎČ¸żë ˝ÇÇŕ ÄÚµĺ
		// ÄÉ¸ŻĹÍżˇ ´ëÇŃ Ăąąř?·Î ZCWAVE_Probe°ˇ TRUE¸¦ ¸®ĹĎ˝Ă,
		// T_FC_CHARACTER_GAMESTART ¸¦ ş¸ł» Ăąąř? ZCWAVE_ProbeÇÔĽö TRUEŔÓŔ» ľË·ÁÁÖľîľßÇŃ´Ů.
		{
			MSG_FC_CHARACTER_GAMESTART sGameStartMsg;
			memset(&sGameStartMsg,0x00,sizeof(sGameStartMsg));
			char buffer[SIZE_MAX_PACKET];
			sGameStartMsg.ClientIndex = m_pShuttleChild->m_myShuttleInfo.ClientIndex;
			sGameStartMsg.CharacterUniqueNumber = m_pShuttleChild->m_myShuttleInfo.CharacterUniqueNumber;
			int nType = T_FC_CHARACTER_GAMESTART;
			memcpy(buffer, &nType, SIZE_FIELD_TYPE_HEADER);
			memcpy(buffer+SIZE_FIELD_TYPE_HEADER, &sGameStartMsg, sizeof(sGameStartMsg));
			g_pD3dApp->m_pFieldWinSocket->Write(buffer, SIZE_FIELD_TYPE_HEADER + sizeof(sGameStartMsg));
			DBGOUT("MoveHackShield_GuidReqMsg : Ready, Send GameStart(T_FC_CHARACTER_GAMESTART, m_bMapLoad = TRUE; m_bLoginChat = IM_SERVER_STATE_READY_FOR_GAMESTART);\n");	
		}
	}	

	DBGOUT("CAtumApplication::FieldSocketMoveXignCodeReqScanInit [%d] \n", bProbe);
#endif // 2009-01-22 by bhsohn Xign Code »çżëÇĎ´Â łŞ¶ó¸¸ ¸đµâ Ăß°ˇ
}

