///////////////////////////////////////////////////////////////////////////////
stcuctRateRect CAtumApplication::GetOptionInterfacePOS()
{
	stcuctRateRect stRtn; 
	memset(&stRtn, 0x00, sizeof(stcuctRateRect));

	if(!g_pSOptionEtc)
	{
		return stRtn;
	}
	memcpy(&stRtn, &g_pSOptionEtc->stRateRect, sizeof(stcuctRateRect));
	return stRtn;
}


