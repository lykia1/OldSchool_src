		case NPGMUP_ERROR_INIT:
			//lpszMsg = TEXT(ˇ°npgmup.des ĂĘ±âČ­ żˇ·ŻŔÔ´Ď´Ů. °ÔŔÓ°ˇµĺĆú´ő¸¦ »čÁ¦ČÄ ´Ů˝Ă °ÔŔÓ˝ÇÇŕŔ» ÇŘşľ´Ď´Ů.ˇ±);
			wsprintf(chMsgStr, STRMSG_C_090310_0212);
			break;
		case NPGMUP_ERROR_DOWNCFG:
			//lpszMsg = TEXT(ˇ°°ÔŔÓ°ˇµĺ ľ÷µĄŔĚĆ® Ľ­ąö Á˘ĽÓżˇ ˝ÇĆĐÇĎż´˝Ŕ´Ď´Ů. Ŕá˝Ă ČÄ Ŕç˝Ăµµ ÇŘş¸°ĹłŞ, °łŔÎ ąćČ­ş®ŔĚ ŔÖ´Ů¸é ĽłÁ¤Ŕ» Á¶Á¤ÇŘ ş¸˝Ă±â ąŮ¶ř´Ď´Ů.ˇ±);
			wsprintf(chMsgStr, STRMSG_C_090310_0213);
			break;
		case NPGMUP_ERROR_AUTH:
			//lpszMsg = TEXT(ˇ°°ÔŔÓ°ˇµĺ ľ÷µĄŔĚĆ®¸¦ żĎ·áÇĎÁö ¸ř Çß˝Ŕ´Ď´Ů. ąŮŔĚ·Ż˝ş ąé˝ĹŔ» ŔĎ˝Ă Áß˝Ă˝ĂĹ˛ ČÄ Ŕç˝Ăµµ ÇŘş¸˝Ă°ĹłŞ, PC °ü¸® ÇÁ·Î±×·ĄŔ» »çżëÇĎ˝Ă¸é ĽłÁ¤Ŕ» Á¶Á¤ÇŘ ş¸˝Ă±â ąŮ¶ř´Ď´Ů.ˇ±);
			wsprintf(chMsgStr, STRMSG_C_090310_0214);
			break;
		case NPGAMEMON_ERROR_NPSCAN:
			//lpszMsg = TEXT(ˇ°ąŮŔĚ·Ż˝ş ą× ÇŘĹ·Ĺř °Ë»ç ¸đµâ ·Îµůżˇ ˝ÇĆĐ Çß˝Ŕ´Ď´Ů. ¸Ţ¸đ¸® şÎÁ·ŔĚ°ĹłŞ ąŮŔĚ·Ż˝şżˇ ŔÇÇŃ °¨ż°ŔĎ Ľö ŔÖ˝Ŕ´Ď´Ů.ˇ±);
			wsprintf(chMsgStr, STRMSG_C_090310_0215);
			break;
		case NPGG_ERROR_COLLISION:
			//lpszMsg = TEXT(ˇ°°ÔŔÓ°ˇµĺżÍ Ăćµą ÇÁ·Î±×·ĄŔĚ ąß°ßµÇľú˝Ŕ´Ď´Ů.ˇ±);
