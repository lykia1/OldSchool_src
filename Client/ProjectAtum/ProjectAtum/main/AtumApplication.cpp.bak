						break;
					default:
						{
							wsprintf(buf, "");
						}
						break;
					}					
					
					if(strlen(buf) > 0)
					{
						m_pChat->CreateChatChild(buf,COLOR_VOIP);
					}					
				}
			}
		}
		break;
		// end 2008-10-14 by bhsohn VOIP°łĽ±
	case AV_EV_NOTIFY:
		{		
			switch(voIP.nMsgParam) 
			{
			case VOIPERR_NtoN_FAIL_REQUEST_TOKEN:
				{
					wsprintf(buf, STRMSG_C_051006_0001);	// "¸»ÇĎ±â ±ÇÇŃ żäĂ» ˝ÇĆĐ!! Ŕá˝Ă ČÄ ´Ů˝Ă ˝ĂµµÇĎĽĽżä"
