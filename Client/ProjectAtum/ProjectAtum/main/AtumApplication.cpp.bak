	{
		CINFCityLab*	pCityLab	= ( (CINFCityLab*)it->second );
		CItemInfo*		pTargetItem	= pCityLab->FindItemFromTarget( pMsg->nItemUID );
		// 2010. 04. 01 by ckPark ¸®ĽŇ˝ş şŻ°ć ˝Ă˝şĹŰ˝Ă ĆŃĹä¸®łŞ ż¬±¸ĽŇżˇĽ­ ľĆŔĚĹŰ Č¸ĽöÇŃ ČÄ şŻ°ćŔĚ ľČµÇ´Â ą®Á¦ ÇŘ°á

