///////////////////////////////////////////////////////////////////////////////
/// \fn			CAtumApplication::FieldSocketItemUpdateItemPos(MSG_FC_ITEM_UPDATE_ITEM_POS* pMsg)
/// \brief		MSG_FC_ITEM_UPDATE_ITEM_POS, Ĺ¸Äł¸ŻĹÍ ľĆŔĚĹŰ ±łĂĽÁ¤ş¸
