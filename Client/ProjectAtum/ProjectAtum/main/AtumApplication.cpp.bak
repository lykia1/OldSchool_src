	// 2009-01-22 by bhsohn Xign Code »çżëÇĎ´Â łŞ¶ó¸¸ ¸đµâ Ăß°ˇ
#if defined(DEFINE_USE_GAMEGUARD_XIGNCODE)			
	MSG_FC_MOVE_XIGNCODE_REQ_SCAN_CHECK_OK sRtnMsg;
