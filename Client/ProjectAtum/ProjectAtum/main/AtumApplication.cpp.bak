///////////////////////////////////////////////////////////////////////////////
/// \fn			
/// \brief		°ÔŔÓ°ˇµĺ ˝ĂŔŰ
/// \author		// 2008-11-28 by bhsohn XignCodeĂß°ˇ
/// \date		2008-11-28 ~ 2008-11-28
/// \warning	
///
/// \param		
/// \return		
///////////////////////////////////////////////////////////////////////////////
BOOL CAtumApplication::SetGameGuardHWND()
{
	int nGameGuard = GAMEGUARD_TYPE;
	switch(nGameGuard)
	{	
		// 2009-01-28 by bhsohn nProtector °ÔŔÓ °ˇµĺ Ăß°ˇ	
	case USE_GAMEGUARD_NPROTECTOR:
		{
#if defined(DEFINE_USE_GAMEGUARD_NPROTECTOR)
			// Ŕ©µµżě ÇÚµéŔĚ »ýĽşµČ ČÄ, ±×¸®°í ¸đµç ±×·ˇÇČ, UI °ü·Ă ĂĘ±âČ­°ˇ łˇł­ ČÄ SetHwnd() ČŁĂâ
			// ŔĚ ÇÔĽö ČŁĂâ ŔĚČÄşÎĹÍ, CallBack ÇÔĽö°ˇ ČŁĂâµÇ±â ˝ĂŔŰÇÔ
			m_pNpgl->SetHwnd(GetHwnd());
			
			// »çżëŔÚ ·Î±×ŔÎ˝Ă ID¸¦ GameMonżˇ Ĺëş¸
			m_pNpgl->Send(m_strUserID); // ąÝµĺ˝Ă ą®ŔÚż­ łˇżˇ Áľ·á(NULL) ¸¦ Ć÷ÇÔ˝ĂÄŃĽ­ Ŕü´ŢÇŘľß ÇŐ´Ď´Ů.
#endif
		}
		break;
		// end 2009-01-28 by bhsohn nProtector °ÔŔÓ °ˇµĺ Ăß°ˇ	
	}
	return TRUE;
}
///////////////////////////////////////////////////////////////////////////////
/// \fn			
/// \brief		
/// \author		// 2009-01-28 by bhsohn nProtector °ÔŔÓ °ˇµĺ Ăß°ˇ
/// \date		2008-12-30 ~ 2008-12-30
/// \warning	
///
/// \param		
/// \return		
///////////////////////////////////////////////////////////////////////////////
BOOL CAtumApplication::TickGetCheckGameGuardNProtector()
{
#if defined(DEFINE_USE_GAMEGUARD_NPROTECTOR)	
	if(NULL == m_pNpgl)
	{
		return FALSE;
	}
	m_fnProtectorHackCheckTime -= GetCheckElapsedTime();
	if(m_fnProtectorHackCheckTime >=0 )
	{
		return TRUE;
	}
	m_fnProtectorHackCheckTime = GAME_GUARD_nPROTECTOR_CHECK_TIME;
	
	// °ÔŔÓ °÷°÷żˇĽ­ ¶Ç´Â Ĺ¸ŔĚ¸ÓżˇĽ­ °ÔŔÓ°ˇµĺ°ˇ ˝ÇÇŕ ÁßŔÎÁö Č®ŔÎ
	if (m_pNpgl->Check() != NPGAMEMON_SUCCESS)
	{
		return FALSE; // °ÔŔÓżˇ ¸Â°Ô ŔűŔýČ÷ Áľ·á˝ĂĹ´
	}
#endif
	return TRUE;
}


///////////////////////////////////////////////////////////////////////////////
/// \fn			
/// \brief		
/// \author		// 2009-01-28 by bhsohn nProtector °ÔŔÓ °ˇµĺ Ăß°ˇ
/// \date		2008-12-30 ~ 2008-12-30
/// \warning	
///
/// \param		
/// \return		
///////////////////////////////////////////////////////////////////////////////
// ¸Ţ˝ĂÁö Ăł¸® Callback ÇÔĽö
// °ÔŔÓ Áľ·á˝Ăżˇ´Â false¸¦ return ÇŘÁÖ°í, Áľ·áÇĎÁö ľĘ´Â °ćżě´Â true¸¦ return ÇŐ´Ď´Ů.
BOOL CALLBACK NPGameMonCallback(DWORD dwMsg, DWORD dwArg)
{
#if defined(DEFINE_USE_GAMEGUARD_NPROTECTOR)	
	char szHackMsg[256] = { 0 };
	ZERO_MEMORY(szHackMsg);

	BOOL bAppExit = false;
	switch (dwMsg)
	{
		// 2009-03-10 by bhsohn nProtector CS¸đµâ Ăß°ˇ
	case NPGAMEMON_CHECK_CSAUTH2:
		{
			// Ľ­ąö·Î ŔÎÁő ĆĐĹ¶Ŕ» ŔüĽŰ. ŔĚ¶§ Callback ÇÔĽö´Â °ÔŔÓ°ˇµĺ ÇÁ·ÎĽĽĽ­°ˇ ČŁĂâÇĎąÇ·Î µż±âČ­°ˇ ÇĘĽö
// 			memcpy(&m_AuthData, (PVOID)dwArg, sizeof(GG_AUTH_DATA));			
// 			SendToServer(&m_AuthData);
			if(g_pD3dApp)
			{
				g_pD3dApp->SendNpGameMonCheckCSAuth2((PVOID)dwArg);
			}
			return true;
		}
		break;
		// end 2009-03-10 by bhsohn nProtector CS¸đµâ Ăß°ˇ
	case NPGAMEMON_COMM_ERROR:
		{
			wsprintf(szHackMsg, "NPGAMEMON_COMM_ERROR");
			bAppExit = true; // Áľ·á ÄÚµĺ						
		}
		break;
	case NPGAMEMON_COMM_CLOSE:
		{
			wsprintf(szHackMsg, "NPGAMEMON_COMM_CLOSE");
			bAppExit = true; // Áľ·á ÄÚµĺ			
		}
		break;
	case NPGAMEMON_INIT_ERROR:
		{
			wsprintf(szHackMsg, "NPGAMEMON_INIT_ERROR");
			bAppExit = true; // Áľ·á ÄÚµĺ			
		}
		break;
	case NPGAMEMON_SPEEDHACK:
		{
			wsprintf(szHackMsg, "NPGAMEMON_SPEEDHACK");
			bAppExit = true; // Áľ·á ÄÚµĺ			
		}
		break;
	case NPGAMEMON_GAMEHACK_KILLED:
		{
			wsprintf(szHackMsg, "NPGAMEMON_GAMEHACK_KILLED");
			bAppExit = true; // Áľ·á ÄÚµĺ			
		}
		break;
	case NPGAMEMON_GAMEHACK_DETECT:
		{
			wsprintf(szHackMsg, "NPGAMEMON_GAMEHACK_DETECT");
			bAppExit = true; // Áľ·á ÄÚµĺ
		}
		break;
	case NPGAMEMON_GAMEHACK_DOUBT:
		{
			wsprintf(szHackMsg, "NPGAMEMON_GAMEHACK_DOUBT");
			bAppExit = true; // Áľ·á ÄÚµĺ			
		}
		break;
	case NPGAMEMON_GAMEHACK_REPORT:
		{
			DWORD dwHackInfoSize = 0;
			LPBYTE pHackInfo = NULL;
			pHackInfo = GetHackInfoFromGameMon(&dwHackInfoSize);
			// pHackInfo = npgl.GetHackInfo(&dwHackInfoSize); // C++ ŔĎ °ćżě.
			if (pHackInfo && dwHackInfoSize > 0)
			{
				// ľĆ·ˇ ÇÔĽö´Â °ÔŔÓ°ˇµĺżˇĽ­ Á¦°řÇĎ´Â ÇÔĽö°ˇ ľĆ´Ő´Ď´Ů.
				//SendToHackLog(pHackInfo, dwHackInfoSize); // Ľ­ąö·Î µĄŔĚĹÍ ŔüĽŰ.
			}
			wsprintf(szHackMsg, "NPGAMEMON_GAMEHACK_REPORT");
			bAppExit = true; // Áľ·á ÄÚµĺ			
		}
		break;
	}
	if(bAppExit)
	{
		if(g_pD3dApp)
		{
			g_pD3dApp->HS_SendHackShieldErrorMsg(dwMsg, szHackMsg);
		}
		return false;
	}
#endif	//#if defined(DEFINE_USE_GAMEGUARD_NPROTECTOR)	
	return true; // °čĽÓ ÁřÇŕ
}


///////////////////////////////////////////////////////////////////////////////
/// \fn			
/// \brief		
/// \author		// 2009-02-03 by bhsohn ąĚĽÇ ˝ĂŔŰ˝Ă żĎ·á ĂĽĹ© ĂĽĹ©
/// \date		2009-02-03 ~ 2009-02-03
/// \warning	
///
/// \param		
/// \return		
///////////////////////////////////////////////////////////////////////////////
void CAtumApplication::FieldSocketQuestPutAllQuestMonsterCountDone()
{
	int nMissionIndex = g_pD3dApp->SerchMissionCondition();
	if(nMissionIndex != NULL)
	{
		g_pD3dApp->SendMissionComplete(nMissionIndex);
	}
}
						

///////////////////////////////////////////////////////////////////////////////
/// \fn			
/// \brief		
/// \author		// 2009-02-13 by bhsohn żůµĺ ·©Ĺ· ˝Ă˝şĹŰ
/// \date		2009-02-20 ~ 2009-02-20
/// \warning	
///
/// \param		
