///////////////////////////////////////////////////////////////////////////////
/// \fn			const char* GetItemDeleteTypeString(BYTE i_byItemDeleteTy)
/// \brief		// 2008-01-23 by cmkwon, S_F, S_L: ÀåÂø/ÀåÂøÇØÁ¦ °ÔÀÓ ·Î±×¿¡ Ãß°¡ - GetItemDeleteTypeString() Ãß°¡
